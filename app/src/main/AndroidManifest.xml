<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin memunculkan notifikasi (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Izin getar untuk alarm -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_map"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_dialog_map"
        android:supportsRtl="true"
        android:theme="@style/Theme.TransitReminder">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service Pembaca Notifikasi Google Maps -->
        <service
            android:name=".MapNotificationListener"
            android:label="Transit Maps Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Receiver Tombol Kapsul ON/OFF di Notifikasi -->
        <receiver
            android:name=".AlarmToggleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.transitreminder.ACTION_TOGGLE_ALARM" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
